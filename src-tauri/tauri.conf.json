{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiro-gateway",
  "version": "0.1.0",
  "identifier": "com.kiro.gateway",
  "build": {
    "beforeDevCommand": "cd web && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd web && npm run build",
    "frontendDist": "../web/dist"
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "app": {
    "windows": [
      {
        "title": "kiro-gateway",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
