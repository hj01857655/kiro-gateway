{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kiro-gateway",
  "version": "0.1.0",
  "identifier": "com.kiro.gateway",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Kiro Gateway",
    "copyright": "Copyright © 2026 Kiro Gateway",
    "category": "DeveloperTool",
    "shortDescription": "Kiro API Gateway",
    "longDescription": "A desktop application for managing Kiro API accounts and providing OpenAI/Anthropic compatible endpoints"
  },
  "app": {
    "windows": [
      {
        "title": "Kiro Gateway",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
